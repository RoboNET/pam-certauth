#!/bin/sh
# postinst - finalize installation.

set -e

CONFIG_DIR=/etc/pam_certauth
CACHE_DIR=/var/cache/pam_certauth/ocsp
STATE_DIR=/var/lib/pam_certauth

case "$1" in
    configure)
        # Create the dedicated system user the daemon runs as. Idempotent:
        # adduser --system is a no-op when the user already exists. The
        # group is created with the same name (--group). No login shell,
        # no home directory.
        if ! getent passwd pamcertauth >/dev/null; then
            adduser --system --group --no-create-home \
                    --home /nonexistent --shell /usr/sbin/nologin \
                    --gecos "pam_certauth daemon" pamcertauth
        fi

        # Tighten config-dir permissions (dh_installdirs ships 0755).
        # Group set to pamcertauth so the daemon can read CA bundle / CRL
        # files via group ACL without needing root or CAP_DAC_OVERRIDE.
        chmod 0750 "$CONFIG_DIR"
        chmod 0750 "$CONFIG_DIR/ca"
        chmod 0750 "$CONFIG_DIR/crl"
        chown root:pamcertauth "$CONFIG_DIR" "$CONFIG_DIR/ca" "$CONFIG_DIR/crl"
        # Config file must be readable by the daemon group too.
        if [ -f "$CONFIG_DIR/config.toml" ]; then
            chown root:pamcertauth "$CONFIG_DIR/config.toml"
            chmod 0640 "$CONFIG_DIR/config.toml"
        fi
        if [ -f "$CONFIG_DIR/ca/bundle.pem" ]; then
            chown root:pamcertauth "$CONFIG_DIR/ca/bundle.pem"
            chmod 0640 "$CONFIG_DIR/ca/bundle.pem"
        fi

        mkdir -p "$CACHE_DIR"
        chmod 0750 "$CACHE_DIR"
        chown pamcertauth:pamcertauth "$CACHE_DIR"
        chown pamcertauth:pamcertauth "$(dirname "$CACHE_DIR")"

        mkdir -p "$STATE_DIR"
        chmod 0750 "$STATE_DIR"
        chown pamcertauth:pamcertauth "$STATE_DIR"

        # Work-order directory is root-owned (PAM module / execute runner
        # writes via sudo or sets up the file under root), readable by the
        # pamcertauth group via the gc service. Keep mode 0750 so other
        # local users cannot enumerate in-flight approvals.
        if [ -d "$STATE_DIR/work_orders" ]; then
            chown root:root "$STATE_DIR/work_orders"
            chmod 0750 "$STATE_DIR/work_orders"
        fi

        # Marker for preinst to detect a clean prior install.
        touch "$STATE_DIR/.installed-by-deb"
        chmod 0640 "$STATE_DIR/.installed-by-deb"
        chown root:pamcertauth "$STATE_DIR/.installed-by-deb"

        # systemd integration.
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            systemd-tmpfiles --create /usr/lib/tmpfiles.d/pam-certauth.conf || true

            # Enable + start the GC timer on first install. Idempotent
            # across upgrades: deb-systemd-helper records the unit's
            # "debian-installed" state on its own.
            if deb-systemd-helper debian-installed pam-certauth-gc.timer 2>/dev/null; then
                : # already configured by a prior install
            else
                deb-systemd-helper enable pam-certauth-gc.timer >/dev/null || true
            fi
            deb-systemd-invoke start pam-certauth-gc.timer >/dev/null || true
        fi

        # Print one-time setup hint if no config has been deployed yet.
        if [ ! -f "$CONFIG_DIR/config.toml" ]; then
            cat <<EOF
==============================================================
pam-certauth installed.

Next steps:
  1. cp /etc/pam_certauth/config.toml.example /etc/pam_certauth/config.toml
     and edit it for your site (CA bundle, host_identity, user_mapping).
  2. Drop CA bundle into /etc/pam_certauth/ca/bundle.pem (mode 0640).
  3. Authorisation is cert-driven (X.509 v3 extensions on the leaf):
     pam_cert_host_binding + pam_cert_user_binding control which hosts
     and which local accounts a cert may sign in to. See README.
  4. systemctl enable --now pam-certauth.service
  5. Integrate the PAM stack:
        sudo /usr/share/pam-certauth/integrate-pam.sh /etc/pam.d/sudo
        sudo /usr/share/pam-certauth/integrate-pam.sh /etc/pam.d/fly-dm
==============================================================
EOF
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument: $1" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
