[Unit]
Description=pam_certauth USB-token monitor daemon
Documentation=file:///usr/share/doc/pam-certauth/README.md.gz
Documentation=man:pam-certauth(8)
After=systemd-udevd.service systemd-logind.service dbus.service
Wants=systemd-tmpfiles-setup.service
Requires=systemd-logind.service

[Service]
Type=notify
# Defence-in-depth: reap any pre-0.2.1 monitord orphans that survived
# upgrade. These ExecStartPre lines need root because the orphan runs
# as root (pre-0.2.1 init.d default); a User=pamcertauth caller would
# hit EPERM and the leading `-` would hide it. The `+` prefix tells
# systemd to run these with full privileges before dropping to
# User=pamcertauth for ExecStart. The new daemon binary lives at
# /usr/bin/pam-certauth (subcommand `daemon`), so the absolute-path
# pattern below cannot match this unit's own ExecStart. The `-` after
# `+` ignores non-zero exits (the common no-match case).
ExecStartPre=+-/usr/bin/pkill --signal TERM -f '^/usr/sbin/pam-certauth-monitord( |$)'
ExecStartPre=+-/bin/sleep 1
ExecStartPre=+-/usr/bin/pkill --signal KILL -f '^/usr/sbin/pam-certauth-monitord( |$)'
# Clean up leaked socket-temp files from killed pre-0.2.1 monitord processes
# whose atomic rename never completed. Without this the next bind can fail
# or pile up unbounded crud under /run/pam_certauth.
ExecStartPre=+-/bin/sh -c 'rm -f /run/pam_certauth/monitord.sock.tmp.*'
# Batch 4 (P1-D): the daemon reads its operational knobs from the SAME shared
# config the PAM cdylib parses, so operators only edit one file. Keep CLI
# flags in mind only as on-the-fly overrides for staging / debugging.
ExecStart=/usr/bin/pam-certauth daemon --config /etc/pam_certauth/config.toml
Restart=on-failure
RestartSec=5s
# Kill the whole cgroup on stop so no children outlive the unit and survive
# as orphan root processes after an upgrade.
KillMode=control-group
TimeoutStopSec=10s
# Run as a dedicated system user (created by postinst). The daemon does
# NOT need root: mount(2) is performed by pam_certauth.so inside the PAM
# caller's context; the daemon's privileged actions (LockSession /
# TerminateSession / PowerOff on logind) are gated by a polkit rule
# shipped at /usr/share/polkit-1/rules.d/49-pam-certauth.rules that
# allows the `pamcertauth` user to invoke those D-Bus methods.
User=pamcertauth
Group=pamcertauth
RuntimeDirectory=pam_certauth
RuntimeDirectoryMode=0750
StateDirectory=pam_certauth
StateDirectoryMode=0750
CacheDirectory=pam_certauth
CacheDirectoryMode=0750
ProtectSystem=strict
ReadWritePaths=/run/pam_certauth /var/cache/pam_certauth /var/lib/pam_certauth
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# MemoryDenyWriteExecute is left off because OpenSSL/gost-engine may need W^X
# relaxation for ASN.1 parser JIT in libcrypto. Stage 8 should benchmark with
# =yes and flip if no measurable regression.
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
